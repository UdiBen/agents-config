# Allowlist strategy: ignore EVERYTHING, then explicitly track only config.
# skills/ is regenerated by link.sh and by `npx skills` (from .skill-lock.json).
/*

# --- tracked config -------------------------------------------------------
!/.gitignore
!/README.md
!/link.sh
!/.skill-lock.json
!/skills-custom/
!/claude/
# core.excludesFile ignores CLAUDE.md everywhere
!/claude/CLAUDE.md

# --- defense-in-depth: never track these even inside tracked dirs ---------
.DS_Store
*.log
*.bak
*.bak.*
*.backup
.credentials.json
settings.local.json
